<Grid
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  x:Name="ComponentRoot" d:DesignWidth="1714" d:DesignHeight="3711">
  <Grid Visibility="{Binding Path=panelVisible}">
    <Rectangle Stroke="#FF000000" IsHitTestVisible="False">
      <Rectangle.Fill>
        <SolidColorBrush Color="#FF1D1D1D" Opacity="0.8"/>
      </Rectangle.Fill>
    </Rectangle>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="30*"/>
        <RowDefinition Height="24*"/>
        <RowDefinition Height="10*"/>
        <RowDefinition Height="159*"/>
        <RowDefinition Height="64*"/>
      </Grid.RowDefinitions>
      <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Right">
        <Grid x:Name="CurrencyBar" Width="1714" Height="324">
          <Image Source="/Root;component/_Data/Images/Rectangle 15225.png" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,60,0" Height="150"/>
          <Image Source="/Root;component/_Data/Images/Currency.png" HorizontalAlignment="Right" VerticalAlignment="Center" Height="180" Width="180" Margin="0,0,452,0"/>
          <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Galindo" TextAlignment="Right" FontSize="70" Margin="0,0,120,0" Text="{Binding Path=currencyString}"/>
        </Grid>
      </Viewbox>
      <Viewbox Grid.Row="3" Stretch="Uniform" Margin="120,0,120,0">
        <Grid Width="1318" Height="1586">
          <Image Source="/Root;component/_Data/Images/bgContainUpgrade.png"/>
          <Button VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding Path=events.onHideUpgrade}" Width="100" Height="80" Margin="0,32,32,0" ClickMode="Press">
            <Button.Background>
              <SolidColorBrush Color="#FF4B5258" Opacity="0"/>
            </Button.Background>
            <Grid Height="100" Width="100" Margin="-50,-180,-50,-180">
              <Image Source="/Root;component/_Data/Images/btnClose.png"/>
            </Grid>
          </Button>
          <Grid Margin="0,200,0,60">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="dameContain">
              <Image Source="/Root;component/_Data/Images/Group 4.png" Margin="80,0,80,0"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" Margin="132,179,0,0" FontSize="28" Text="{Binding Path=levelDame}"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" FontSize="36" Margin="334,-0,-0,144" Text="Damage" Stroke="#FF000000" StrokeThickness="4"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" FontSize="36" Margin="334,104,-0,-0" Text="{Binding Path=valueDame}"/>
              <Button VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0,0,0,0" Height="120" Margin="0,0,180,0" Width="240" Command="{Binding Path=events.onDameUpgrade}">
                <Button.Background>
                  <SolidColorBrush Color="#FF000000" Opacity="0"/>
                </Button.Background>
                <Grid Margin="-60,-20,-60,-20">
                  <Image Source="/Root;component/_Data/Images/btnGreen.png" Stretch="Fill"/>
                  <Image Source="/Root;component/_Data/Images/Currency.png" VerticalAlignment="Center" HorizontalAlignment="Left" Width="60" Height="60" Margin="20,0,0,0"/>
                  <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" Margin="100,0,30,0" Stroke="#FF181818" StrokeThickness="4" FontSize="50" Text="{Binding Path=costDame}" Foreground="{Binding Path=fgCostDame}"/>
                </Grid>
              </Button>
            </Grid>
            <Grid x:Name="critContain" Grid.Row="1">
              <Image Margin="80,0,80,0" Source="/Root;component/_Data/Images/Group 6.png"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" Margin="132,179,0,0" FontSize="28" Text="{Binding Path=levelCrit}"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" FontSize="36" Margin="334,-0,-0,144" Text="Critical Chance" StrokeThickness="4" Stroke="#FF000000"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" FontSize="36" Margin="334,104,-0,-0" Text="{Binding Path=valueCrit}"/>
              <Button VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0,0,0,0" Height="120" Margin="0,0,180,0" Width="240" Command="{Binding Path=events.onCritUpgrade}">
                <Button.Background>
                  <SolidColorBrush Color="#FF000000" Opacity="0"/>
                </Button.Background>
                <Grid Margin="-60,-20,-60,-20">
                  <Image Source="/Root;component/_Data/Images/btnGreen.png" Stretch="Fill"/>
                  <Image Source="/Root;component/_Data/Images/Currency.png" VerticalAlignment="Center" HorizontalAlignment="Left" Width="60" Height="60" Margin="20,0,0,0"/>
                  <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" Margin="100,0,30,0" Stroke="#FF181818" StrokeThickness="4" Text="{Binding Path=costCrit}" FontSize="50" Foreground="{Binding Path=fgCostCrit}"/>
                </Grid>
              </Button>
            </Grid>
            <Grid x:Name="atkSpdContain" Grid.Row="2">
              <Image Margin="80,0,80,0" Source="/Root;component/_Data/Images/Group 5.png"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" Margin="132,179,0,0" FontSize="28" Text="{Binding Path=levelAtkspd}"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" FontSize="36" Margin="334,-0,-0,144" Text="Attack Speed" StrokeThickness="4" Stroke="#FF000000"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" FontSize="36" Margin="334,104,-0,-0" Text="{Binding Path=valueAtkspd}"/>
              <Button VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0,0,0,0" Height="120" Margin="0,0,180,0" Width="240" Command="{Binding Path=events.onAtkspdUpgrade}">
                <Button.Background>
                  <SolidColorBrush Color="#FF000000" Opacity="0"/>
                </Button.Background>
                <Grid Margin="-60,-20,-60,-20">
                  <Image Source="/Root;component/_Data/Images/btnGreen.png" Stretch="Fill"/>
                  <Image Source="/Root;component/_Data/Images/Currency.png" VerticalAlignment="Center" HorizontalAlignment="Left" Width="60" Height="60" Margin="20,0,0,0"/>
                  <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" Margin="100,0,30,0" Stroke="#FF181818" StrokeThickness="4" Text="{Binding Path=costAtkspd}" FontSize="50" Foreground="{Binding Path=fgCostAtkspd}"/>
                </Grid>
              </Button>
            </Grid>
            <Grid x:Name="hpContain" Grid.Row="3">
              <Image Margin="80,0,80,0" Source="/Root;component/_Data/Images/Group 7.png"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" Margin="132,179,0,0" FontSize="28" Text="{Binding Path=levelHP}"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" FontSize="36" Margin="334,-0,-0,144" Text="Health point" StrokeThickness="4" Stroke="#FF000000"/>
              <TextBlock Foreground="#FFFFFFFF" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" FontSize="36" Margin="334,104,-0,-0" Text="{Binding Path=valueHP}"/>
              <Button VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0,0,0,0" Height="120" Margin="0,0,180,0" Width="240" Command="{Binding Path=events.onHPUpgrade}">
                <Button.Background>
                  <SolidColorBrush Color="#FF000000" Opacity="0"/>
                </Button.Background>
                <Grid Margin="-60,-20,-60,-20">
                  <Image Source="/Root;component/_Data/Images/btnGreen.png" Stretch="Fill"/>
                  <Image Source="/Root;component/_Data/Images/Currency.png" VerticalAlignment="Center" HorizontalAlignment="Left" Width="60" Height="60" Margin="20,0,0,0"/>
                  <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Galindo" Margin="100,0,30,0" Stroke="#FF181818" StrokeThickness="4" Text="{Binding Path=costHP}" FontSize="50" Foreground="{Binding Path=fgCostHP}"/>
                </Grid>
              </Button>
            </Grid>
          </Grid>
        </Grid>
      </Viewbox>
    </Grid>
  </Grid>
</Grid>
