<Component
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:noesis="clr-namespace:NoesisStudioInternals"
  xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
  mc:Ignorable="d"
  x:Name="LeaderboardRoot" d:DesignWidth="360" d:DesignHeight="640" d:DataContext="LeaderboardDataset">
  <Component.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Root;component/assets/leaderboard/ui/LeaderboardResource.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Component.Resources>

  <Viewbox x:Name="LeaderboardViewbox">
    <Border x:Name="LeaderboardBorder" Width="360" Height="640">
      <Grid x:Name="LeaderboardGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="6*"/>
          <RowDefinition Height="80*"/>
          <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>
        <Border x:Name="LeaderboardHeaderBorder" BorderBrush="#FF000000" BorderThickness="2,2,2,2" CornerRadius="8,8,0,0">
          <Border.Background>
            <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
              <GradientStop Offset="0" Color="#FFFDC161"/>
              <GradientStop Offset="1" Color="#FFFC5252"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid x:Name="LeaderboardHeader">
            <TextBlock x:Name="LeaderboardTitle" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource LeaderboardTitleStyle}" Text="LEADERBOARD"/>
            <Button x:Name="LeaderboardExitButton" Command="{Binding Path=events.CloseLeaderboard}" Padding="0,0,0,0" HorizontalAlignment="Right">
              <Button.Background>
                <SolidColorBrush Color="#FF4B5258" Opacity="0"/>
              </Button.Background>
              <Image x:Name="LeaderboardExitButtonImage" Source="/Root;component/assets/leaderboard/ui/icons/icon_close.png"/>
            </Button>
          </Grid>
        </Border>
        <Border x:Name="LeaderboardBodyBorder" BorderBrush="#FF000000" Grid.Row="1" Padding="8,8,8,8" BorderThickness="2,0,2,2" CornerRadius="0,0,8,8">
          <Border.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
              <GradientStop Color="#FF185288" Offset="0"/>
              <GradientStop Color="#FF222973" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid x:Name="LeaderboardBody">
            <Border x:Name="LeaderboardItemsBorder" BorderBrush="#FF000000" Background="#FF202036" CornerRadius="4,4,4,4" BorderThickness="2,2,2,2" Padding="4,4,4,4">
              <ItemsControl x:Name="LeaderboardItems" ItemsSource="{Binding Path=LeaderboardEntries}" ItemTemplate="{StaticResource LeaderboardEntryDataTemplate}" ItemsPanel="{DynamicResource LeaderboardItemsPanelTemplate}"/>
            </Border>
          </Grid>
        </Border>
        <StackPanel x:Name="LeaderboardPageNumber" Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="CurrentPage" Text="{Binding Path=CurrentPageNumber}" Style="{DynamicResource LeaderboardEntryTextStyle}"/>
          <TextBlock x:Name="Slash" TextWrapping="Wrap" Foreground="#FFFFFFFF" FontSize="16" Text="/" Visibility="Collapsed"/>
          <TextBlock x:Name="MaxPage" TextWrapping="Wrap" Foreground="#FFFFFFFF" FontSize="16" Text="{Binding Path=MaximumPageNumber}" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel x:Name="LeaderboardNavigationButtons" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" Grid.Row="2">
          <Button x:Name="PreviousPageButton" Command="{Binding Path=events.ShowPreviousPage}" IsEnabled="{Binding Path=CanViewPreviousPage}" Margin="0,0,20,0">
            <Button.Background>
              <SolidColorBrush Color="#FFFFFFFF" Opacity="0"/>
            </Button.Background>
            <Image x:Name="PreviousPageImageButton" Source="/Root;component/assets/leaderboard/ui/icons/icon_previous-page.png" Height="40"/>
          </Button>
          <Button x:Name="NextPageButton" Command="{Binding Path=events.ShowNextPage}" IsEnabled="{Binding Path=CanViewNextPage}" Margin="20,0,0,0">
            <Button.Background>
              <SolidColorBrush Color="#FFFFFFFF" Opacity="0"/>
            </Button.Background>
            <Image x:Name="NextPageImageButton" Source="/Root;component/assets/leaderboard/ui/icons/icon_next-page.png" Height="40"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Viewbox>
</Component>
